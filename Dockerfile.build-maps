FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/tobymao/sqlglot.git /app/sqlglot \
    && git -C /app/sqlglot checkout eb11aec4be8cb2122afe713a4816662c3f0fb2fa

COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r /app/requirements.lock
RUN pip install --no-cache-dir coverage pytest-cov

COPY tools/class_tracker.py /app/plugins/class_tracker.py

RUN cd /app/sqlglot && PYTHONPATH=/app/plugins REPO=/app/sqlglot CLASS_LOG=/app/class_use.log SKIP_INTEGRATION=0 python -m pytest -q -p class_tracker --cov=sqlglot --cov-context=test --cov-report= || test -f /app/sqlglot/.coverage
RUN cd /app/sqlglot && python -m coverage json --show-contexts -o /app/coverage.json